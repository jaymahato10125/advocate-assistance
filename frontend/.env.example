# Base URL the browser uses to reach the Advocate Contracts API.
# Leave UNSET in local development — next.config.ts proxies /api/* to
# http://127.0.0.1:8000/* so no CORS configuration is needed.
# In production, point this at the deployed API:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional: override the dev proxy target (defaults to http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: canonical site URL used for SEO metadata
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk authentication — https://dashboard.clerk.com -> API Keys.
# Copy these into frontend/.env.local (never commit real keys).
# The CLERK_SECRET_KEY must match the FastAPI backend's CLERK_SECRET_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
