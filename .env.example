# MongoDB Atlas connection string.
# URL-encode special characters in the username or password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mydb

GEMINI_API_KEY=your-google-ai-studio-api-key
# Set these four values to use the private Cloudflare R2 bucket. When all four
# are present, the API automatically uses R2; otherwise it uses local uploads.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=advocate-contracts
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
UPLOADS_DIR=uploads
ALLOWED_EXTENSIONS=[".pdf", ".txt"]
MAX_FILE_SIZE_MB=10

# Clerk authentication (https://dashboard.clerk.com -> API Keys).
# The same secret key is used by the Next.js frontend.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# Origins allowed in the session token's `azp` claim (JSON or comma-separated).
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Browser origins allowed to call the API directly (production CORS).
CORS_ORIGINS=["http://localhost:3000"]
# Local-dev escape hatch: treats every request as a fixed dev user and skips
# Clerk verification. NEVER set to true in production.
AUTH_DISABLED=false
