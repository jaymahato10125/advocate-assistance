# Base URL the browser uses to reach the Advocate Contracts API.
# Leave UNSET in local development — next.config.ts proxies /api/* to
# http://127.0.0.1:8000/* so no CORS configuration is needed.
# In production, point this at the deployed API:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional: override the dev proxy target (defaults to http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: canonical site URL used for SEO metadata
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
